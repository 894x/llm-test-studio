{
  "id": "must.tool_choice_allowed_tools",
  "name": "工具调用 · tool_choice=allowed_tools",
  "dimension": "tools",
  "protocol": "kimi-k3",
  "kind": "kimi_tool_call",
  "default": false,
  "severity": "critical",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "messages": [{"role": "user", "content": "查询北京天气。"}],
      "tools": [
        {"type": "function", "function": {"name": "get_weather", "description": "查询天气", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}},
        {"type": "function", "function": {"name": "get_time", "description": "查询时间", "parameters": {"type": "object", "properties": {}}}}
      ],
      "tool_choice": {"type": "allowed_tools", "function": {"name": ["get_weather"]}},
      "max_tokens": 200
    }
  },
  "options": {"expected_tool_name": "get_weather"}
}
