{
  "schema_version": 2,
  "key": "wan30.media.link_single",
  "name": "Wan 3.0 · 单网页链接输入",
  "dimension": "dependencies",
  "protocol": "wan-video",
  "model_targets": [
    "wan3.0-video",
    "wan3.0-video-prime"
  ],
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "wan_task_success",
      "request": {
        "method": "POST",
        "path": "/api/v1/services/aigc/video-generation/video-synthesis",
        "headers": {
          "X-DashScope-Async": "enable"
        },
        "body": {
          "input": {
            "media": [
              {
                "type": "link",
                "url": "fixture://wan3/link/public-page"
              }
            ]
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "options": {
        "reason": "需要稳定且无需登录的公开页面",
        "precondition": "需要将 fixture:// 别名解析为同地域可访问且满足边界属性的确定性素材"
      }
    }
  }
}
