{
  "schema_version": 2,
  "key": "wan30.media.reference_mix",
  "name": "Wan 3.0 · 图像视频音频参考组合",
  "dimension": "dependencies",
  "protocol": "wan-video",
  "model_targets": [
    "wan3.0-video",
    "wan3.0-video-prime"
  ],
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "wan_task_success",
      "request": {
        "method": "POST",
        "path": "/api/v1/services/aigc/video-generation/video-synthesis",
        "headers": {
          "X-DashScope-Async": "enable"
        },
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_image",
                "url": "fixture://wan3/image/reference.jpg"
              },
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/valid-5s.mp4"
              },
              {
                "type": "reference_audio",
                "url": "fixture://wan3/audio/valid-5s.mp3"
              }
            ],
            "prompt": "参考图片1、视频1和音频1生成短片"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "options": {
        "reason": "需要三类相互匹配的确定性素材",
        "precondition": "需要将 fixture:// 别名解析为同地域可访问且满足边界属性的确定性素材"
      }
    }
  }
}
