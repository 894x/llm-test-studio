{
  "schema_version": 2,
  "key": "wan30.prompt.video_indexing",
  "name": "Wan 3.0 · Prompt 按顺序引用视频编号",
  "dimension": "semantic",
  "protocol": "wan-video",
  "model_targets": [
    "wan3.0-video",
    "wan3.0-video-prime"
  ],
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "wan_task_success",
      "request": {
        "method": "POST",
        "path": "/api/v1/services/aigc/video-generation/video-synthesis",
        "headers": {
          "X-DashScope-Async": "enable"
        },
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/action-a.mp4"
              },
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/action-b.mp4"
              }
            ],
            "prompt": "先参考视频1的动作，再参考视频2的动作"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "options": {
        "reason": "需要可判定编号顺序的视频语义 oracle",
        "precondition": "将 fixture:// 别名解析为同地域可访问、属性已校验的确定性素材"
      }
    }
  }
}
