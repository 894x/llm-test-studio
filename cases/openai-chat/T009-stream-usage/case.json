{
  "schema_version": 2,
  "key": "T009",
  "name": "流式 usage 支持检测",
  "dimension": "billing",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "stream_usage",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出 STREAM_USAGE_OK"
            }
          ],
          "temperature": 0,
          "max_tokens": 32,
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "options": {}
    }
  }
}
