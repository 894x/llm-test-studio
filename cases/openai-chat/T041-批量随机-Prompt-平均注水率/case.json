{
  "schema_version": 2,
  "key": "T041",
  "name": "批量短输出 usage 上限",
  "dimension": "stability",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "padding_ratio",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出 PAD_OK"
            }
          ],
          "temperature": 0,
          "max_tokens": 256
        }
      },
      "options": {
        "expected_exact": "PAD_OK",
        "max_completion_tokens": 6,
        "repetitions": 6
      }
    }
  }
}
