{
  "id": "T005",
  "name": "输出 Token 精准核验",
  "dimension": "billing",
  "protocol": "openai-chat",
  "kind": "chat_sync",
  "default": false,
  "severity": "normal",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "仅输出单个数字 5，不要解释。"
        }
      ],
      "temperature": 0,
      "max_tokens": 8
    }
  },
  "options": {
    "expected_exact": "5",
    "require_usage": true,
    "max_completion_tokens": 3
  }
}
