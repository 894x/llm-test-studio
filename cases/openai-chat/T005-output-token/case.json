{
  "schema_version": 2,
  "key": "T005",
  "name": "输出 Token 精准核验",
  "dimension": "billing",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "chat_sync",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出单个数字 5，不要解释。"
            }
          ],
          "temperature": 0,
          "max_tokens": 8
        }
      },
      "options": {
        "expected_exact": "5",
        "max_completion_tokens": 3,
        "require_usage": true
      }
    }
  }
}
