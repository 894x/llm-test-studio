{
  "schema_version": 1,
  "protocol": "openai-chat",
  "model_target": "glm-5.3",
  "profiles": [
    {
      "directory": "glm-5.3-connectivity",
      "key": "openai-chat.glm-5.3.connectivity",
      "name": "GLM 5.3 连通性套件",
      "case_keys": [
        "glm53.connectivity",
        "glm53.auth.missing",
        "glm53.auth.invalid"
      ],
      "quick_test": {
        "description": "验证 GLM 5.3 的思考、最终回答，以及缺失和无效凭据的拒绝响应。适用于普通 Model API。",
        "timeout_ms": 120000,
        "inputs": [
          {
            "key": "prompt",
            "label": "提示词",
            "type": "text",
            "default": "Reply with the word GLM_OK.",
            "bindings": [
              {
                "case_key": "glm53.connectivity",
                "pointer": "/request/body/messages/0/content"
              }
            ]
          }
        ]
      }
    },
    {
      "directory": "glm-5.3-basic",
      "key": "openai-chat.glm-5.3.basic",
      "name": "GLM 5.3 基本功能套件",
      "case_keys": [
        "glm53.connectivity",
        "glm53.auth.missing",
        "glm53.auth.invalid",
        "glm53.thinking.enabled",
        "glm53.reasoning_effort.valid_0",
        "glm53.stream.true",
        "glm53.format.json",
        "glm53.tools.roundtrip",
        "glm53.tools.stream_true",
        "glm53.thinking.replay_false",
        "glm53.cache.counter",
        "glm53.thinking.disabled"
      ]
    },
    {
      "directory": "glm-5.3-parameter-rejection",
      "key": "openai-chat.glm-5.3.parameter-rejection",
      "name": "GLM 5.3 参数拒绝套件",
      "selector": {
