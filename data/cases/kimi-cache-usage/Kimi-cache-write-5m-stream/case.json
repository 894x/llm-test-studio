  "key": "kimi.cache.write_5m_stream",
  "name": "Kimi 缓存 · 5m · 写入对账 · 流式",
  "description": "T3；适用 kimi-k3 / kimi-k3.1-pro；5m TTL；最终流式 usage。新随机长前缀必须实际写入，避免缓存预热造成伪通过。Chat 同时核验 MSH 两档计数；Responses 核验原生 usage；Messages 核验 cache_creation 两档拆分。运行需要付费，不在日常套件执行。来源：https://platform.kimi.com/docs/guide/context-caching，核验日期 2026-11-03。",
  "dimension": "cache",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "system",
              "content": {
                "$generate": "concat",
                "parts": [
                  {
                    "$generate": "random_text",
                    "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567",
                    "length": 48
                  },
                  "\n",
                  {
                    "$generate": "repeat",
                    "text": "缓存测试资料：alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu. 每次请求保持资料和顺序一致。\n",
                    "count": 128
                  }
                ]
              }
            },
            {
              "role": "user",
              "content": "只回答 OK。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "stream": true,
          "stream_options": {
            "include_usage": true
          },
          "prompt_cache_options": {
            "mode": "implicit",
            "ttl": "5m"
          }
        }
      },
