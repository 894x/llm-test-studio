{
  "schema_version": 2,
  "id": "d2268150-1e3f-5de2-828f-d86fd0629476",
  "key": "k31.tool_parameters_required",
  "name": "K3.1 Pro · 工具定义 · 缺少 parameters 应拒绝",
  "dimension": "tools",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "只回答 OK。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "查询天气"
              }
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_message",
          "source": "response",
          "pointer": "/error/message",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
