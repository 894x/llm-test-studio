{
  "schema_version": 1,
  "key": "stop_five_items",
  "name": "Stop · 5 个字符串上边界",
  "dimension": "parameters",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "只回答：你好"
            }
          ],
          "stop": [
            "stop-a",
            "stop-b",
            "stop-c",
            "stop-d",
            "stop-e"
          ],
          "max_completion_tokens": 32
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    }
  }
}
