{
  "schema_version": 3,
  "key": "T001",
  "name": "同步响应检测",
  "dimension": "boundary",
  "protocol": "openai-chat",
  "enabled": true,
  "default": true,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "仅输出数字 5"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 256
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
