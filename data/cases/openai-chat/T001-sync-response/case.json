{
  "schema_version": 3,
  "id": "062b66ef-8d2e-59a1-95cb-dadf03dfe264",
  "key": "T001",
  "name": "同步响应检测",
  "description": "目的：用一条短消息检查所选协议的同步文本响应。前提：配置可用的模型、渠道和凭据；可通过 prompt 输入替换默认提示词。通过：HTTP 状态、响应结构及非空文本满足当前协议定义的断言。范围：仅验证本次基础响应，不校验是否严格回答数字 5，也不证明内容质量、流式能力或持续可用性。",
  "dimension": "boundary",
  "enabled": true,
  "default": true,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "仅输出数字 5"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 256
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    },
    "openai-responses": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "仅输出数字 5"
        }
      },
      "request": {
        "body": {
          "input": {
            "$input": "prompt"
          },
          "max_output_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    },
    "anthropic-messages": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "仅输出数字 5"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "message",
          "source": "response",
          "pointer": "/type",
          "operator": "equals",
          "value": "message"
        },
        {
          "id": "stop",
          "source": "response",
          "pointer": "/stop_reason",
          "operator": "non_empty"
        },
        {
          "id": "text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
