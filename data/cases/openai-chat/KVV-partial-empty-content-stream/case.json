{
  "schema_version": 3,
  "id": "fc7b22d9-bd81-4a1c-8e73-3b3e5e3edd1f",
  "key": "kvv.partial_empty_content.stream",
  "name": "KVV · Partial 续写 · partial 预填（reasoning + 空 content） · stream",
  "description": "目的：检查 Partial 请求能否返回后续正文，不比较 token 数目。范围：保留 KVV kvv.partial_empty_content.stream 的原始请求字段组合，SSE 完整结束且无协议错误；正文必须包含非空白字符。正文前缀为空或缺失，仅检查后续输出；不据此证明隐藏推理的续写。不核验固定答案或推理内容。来源：Moonshot KVV 66092cf cases.partial.jsonl；本项目采用续写格式判据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "hello"
            },
            {
              "role": "assistant",
              "reasoning_content": "reasoning",
              "content": "",
              "partial": true
            }
          ],
          "reasoning_effort": "max",
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "finish",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "content_type",
          "source": "response",
          "operator": "type",
          "pointer": "/choices/0/message/content",
          "value": "string"
        },
        {
          "id": "continuation",
          "source": "text",
          "operator": "regex",
          "value": "\\S"
        }
      ]
    }
  }
}
