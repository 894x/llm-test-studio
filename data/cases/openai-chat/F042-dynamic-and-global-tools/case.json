              "id": "function_type",
              "source": "item",
              "operator": "equals",
              "pointer": "/type",
              "value": "function_call"
            },
            {
              "id": "function_name",
              "source": "item",
              "operator": "equals",
              "pointer": "/name",
              "value": "dynamic_calculate"
            },
            {
              "id": "call_id",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/call_id"
            },
            {
              "id": "arguments",
              "source": "item",
              "operator": "json_valid",
              "pointer": "/arguments"
            }
          ]
