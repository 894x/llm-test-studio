                {
                  "type": "function",
                  "function": {
                    "name": "dynamic_calculate",
                    "description": "计算算术表达式",
                    "parameters": {
                      "type": "object",
                      "properties": {
                        "expression": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "expression"
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "global_lookup",
                "description": "查询固定信息",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query"
                  ]
                }
              }
            }
          ],
          "max_completion_tokens": 128
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    }
  }
