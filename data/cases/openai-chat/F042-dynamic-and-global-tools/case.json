  "key": "dynamic_and_global_tools",
  "name": "动态工具 · 与顶层全局工具并存",
  "dimension": "tools",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
