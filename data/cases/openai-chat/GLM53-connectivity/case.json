{
  "schema_version": 1,
  "key": "glm53.connectivity",
  "name": "GLM 5.3 · 连通性与最终回答",
  "dimension": "glm53.transport",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "Reply with the word GLM_OK."
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r12",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
