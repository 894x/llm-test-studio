{
  "schema_version": 2,
  "id": "a1d68ebd-6a8e-5446-a4a0-33eccabe2ec1",
  "key": "T025",
  "name": "长流式断连率",
  "dimension": "stability",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "输出从 1 到 80 的整数，每个数字用英文逗号分隔，不要解释。"
            }
          ],
          "temperature": 0,
          "max_tokens": 256,
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "r4",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/stream_frames",
          "value": 2
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/finish_reason"
        },
        {
          "id": "r6",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r9",
          "any": [
            {
              "id": "r7",
              "source": "text",
              "operator": "non_empty",
              "transform": "trim"
            },
            {
              "id": "r8",
              "source": "response",
              "operator": "non_empty",
              "pointer": "/choices/0/message/reasoning_content",
              "transform": "trim"
            }
          ]
        }
      ]
    }
  }
}
