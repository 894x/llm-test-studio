{
  "schema_version": 2,
  "key": "T025",
  "name": "长流式断连率",
  "dimension": "stability",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "long_stream_stability",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "输出从 1 到 80 的整数，每个数字用英文逗号分隔，不要解释。"
            }
          ],
          "temperature": 0,
          "max_tokens": 256,
          "stream": true
        }
      },
      "options": {
        "repetitions": 3
      }
    }
  }
}
