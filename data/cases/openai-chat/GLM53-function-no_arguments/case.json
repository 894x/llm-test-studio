{
  "schema_version": 1,
  "key": "glm53.function.no_arguments",
  "name": "GLM 5.3 · 无参数函数 Schema",
  "dimension": "glm53.function_schema",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "read_fixture",
                "description": "Read the deterministic test fixture. Always call this tool when asked for the fixture.",
                "parameters": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          ]
        }
      },
      "assertions":             [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r24",
          "any": [
            {
              "id": "r13",
              "all": [
                {
                  "id": "r11",
                  "source": "response",
                  "operator": "equals",
                  "pointer": "/choices/0/finish_reason",
                  "value": "stop"
                },
                {
                  "id": "r12",
                  "source": "text",
                  "operator": "non_empty",
                  "transform": "trim"
                }
              ]
            },
            {
              "id": "r23",
              "all": [
                {
                  "id": "r21",
                  "source": "response",
                  "operator": "equals",
                  "pointer": "/choices/0/finish_reason",
                  "value": "tool_calls"
                },
                {
                  "id": "r19",
                  "source": "response",
                  "operator": "non_empty",
                  "pointer": "/choices/0/message/tool_calls"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
