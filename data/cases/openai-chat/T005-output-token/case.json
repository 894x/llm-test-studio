{
  "schema_version": 1,
  "key": "T005",
  "name": "输出 Token 精准核验",
  "dimension": "billing",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出单个数字 5，不要解释。"
            }
          ],
          "temperature": 0,
          "max_tokens": 8
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r5",
          "source": "text",
          "operator": "equals",
          "value": "5",
          "transform": "trim"
        },
        {
          "id": "r6",
          "source": "usage",
          "operator": "type",
          "value": "object"
        },
        {
          "id": "r7",
          "source": "usage",
          "operator": "lte",
          "pointer": "/completion_tokens",
          "value": 3
        }
      ]
    }
  }
}
