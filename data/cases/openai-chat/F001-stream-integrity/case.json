{
  "schema_version": 2,
  "id": "7df57c19-7d18-566a-998e-86342b7cee32",
  "key": "must.stream_integrity",
  "name": "协议 · Stream 完整性",
  "dimension": "protocol",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说你好"
            }
          ],
          "max_tokens": 50,
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "r4",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/stream_frames",
          "value": 2
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/finish_reason"
        },
        {
          "id": "r6",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r7",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_data_after_done",
          "value": 0
        },
        {
          "id": "r8",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_content_after_finish",
          "value": 0
        },
        {
          "id": "r9",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_invalid_delta_count",
          "value": 0
        },
        {
          "id": "r10",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_provider_error_count",
          "value": 0
        },
        {
          "id": "r11",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_identity_missing_count",
          "value": 0
        },
        {
          "id": "r12",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_response_ids",
          "value": 1
        },
        {
          "id": "r13",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_model_ids",
          "value": 1
        },
        {
          "id": "r14",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_finish_count",
          "value": 1
        },
        {
          "id": "r17",
          "any": [
            {
              "id": "r15",
              "source": "text",
              "operator": "non_empty",
              "transform": "trim"
            },
            {
              "id": "r16",
              "source": "response",
              "operator": "non_empty",
              "pointer": "/choices/0/message/reasoning_content",
              "transform": "trim"
            }
          ]
        }
      ]
    },
    "openai-responses": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": {
            "$input": "prompt"
          },
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "pointer": "/object",
          "value": "response"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "pointer": "/status",
          "value": "completed"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "stream_terminal",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "visible_text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    },
    "anthropic-messages": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 2048,
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "message",
          "source": "response",
          "pointer": "/type",
          "operator": "equals",
          "value": "message"
        },
        {
          "id": "stop",
          "source": "response",
          "pointer": "/stop_reason",
          "operator": "non_empty"
        },
        {
          "id": "stream",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
