{
  "schema_version": 2,
  "id": "34e241fa-9d4d-55d0-b3c2-49413480e8e9",
  "key": "reasoning_effort_max",
  "name": "推理强度 · reasoning_effort=max",
  "dimension": "reasoning-parameters",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说明 1+1=2。"
            }
          ],
          "reasoning_effort": "max",
          "max_completion_tokens": 128
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "说明 1+1=2。"
            }
          ],
          "reasoning": {
            "effort": "max"
          }
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "terminal",
          "any": [
            {
              "id": "completed_output",
              "all": [
                {
                  "id": "completed",
                  "source": "response",
                  "operator": "equals",
                  "pointer": "/status",
                  "value": "completed"
                },
                {
                  "id": "visible_text",
                  "source": "text",
                  "operator": "non_empty"
                }
              ]
            },
            {
              "id": "budget_truncation",
              "all": [
                {
                  "id": "incomplete",
                  "source": "response",
                  "operator": "equals",
                  "pointer": "/status",
                  "value": "incomplete"
                },
                {
                  "id": "limit_reason",
                  "source": "response",
                  "operator": "equals",
                  "pointer": "/incomplete_details/reason",
                  "value": "max_output_tokens"
                },
                {
                  "id": "bounded_output",
                  "any": [
                    {
                      "id": "bounded_output_omitted",
                      "source": "response",
                      "pointer": "/usage/output_tokens",
                      "operator": "not_exists"
                    },
                    {
                      "id": "bounded_output_value",
                      "source": "response",
                      "operator": "lte",
                      "pointer": "/usage/output_tokens",
                      "expected_from": {
                        "source": "request",
                        "pointer": "/max_output_tokens"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
