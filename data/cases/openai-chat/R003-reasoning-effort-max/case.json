{
  "schema_version": 3,
  "key": "reasoning_effort_max",
  "name": "推理强度 · reasoning_effort=max",
  "dimension": "reasoning-parameters",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说明 1+1=2。"
            }
          ],
          "reasoning_effort": "max",
          "max_completion_tokens": 128
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/reasoning_visible",
          "value": 1
        }
      ]
    }
  }
}
