{
  "schema_version": 2,
  "id": "510151ef-a1fc-53e3-8d15-f0b28842a33e",
  "key": "max_completion_minimal",
  "name": "输出长度 · max_completion_tokens=1 最小代表值",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "你好"
            }
          ],
          "max_completion_tokens": 1
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 1,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "你好"
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "pointer": "/status",
          "value": "incomplete"
        },
        {
          "id": "limit_reason",
          "source": "response",
          "operator": "equals",
          "pointer": "/incomplete_details/reason",
          "value": "max_output_tokens"
        },
        {
          "id": "bounded_output",
          "any": [
            {
              "id": "bounded_output_omitted",
              "source": "response",
              "pointer": "/usage/output_tokens",
              "operator": "not_exists"
            },
            {
              "id": "bounded_output_value",
              "source": "response",
              "operator": "lte",
              "pointer": "/usage/output_tokens",
              "value": 1
            }
          ]
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        }
      ]
    }
  }
}
