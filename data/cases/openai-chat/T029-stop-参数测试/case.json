{
  "schema_version": 2,
  "key": "T029",
  "name": "stop 参数测试",
  "dimension": "boundary",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "stop_parameter",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "依次输出 苹果、香蕉、STOP_AUDIT、橙子"
            }
          ],
          "stop": [
            "STOP_AUDIT"
          ],
          "temperature": 0,
          "max_tokens": 64
        }
      },
      "options": {
        "stop_text": "STOP_AUDIT"
      }
    }
  }
}
