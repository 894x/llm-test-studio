{
  "schema_version": 3,
  "key": "T029",
  "name": "stop 参数测试",
  "dimension": "boundary",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "依次输出 苹果、香蕉、STOP_AUDIT、橙子"
            }
          ],
          "stop": [
            "STOP_AUDIT"
          ],
          "temperature": 0,
          "max_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "text",
          "operator": "not_contains",
          "value": "STOP_AUDIT"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        }
      ]
    }
  }
}
