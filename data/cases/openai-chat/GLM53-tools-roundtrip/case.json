{
  "schema_version": 2,
  "id": "2457775a-b2b1-502a-90bc-753ac46cba5e",
  "key": "glm53.tools.roundtrip",
  "name": "GLM 5.3 · 函数调用与结果回传",
  "dimension": "glm53.tool_lifecycle",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Call read_fixture with label sample to read the test fixture. Do not invent the result."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "read_fixture",
                "description": "Read the deterministic test fixture. Always call this tool when asked for the fixture.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "enum": [
                        "sample"
                      ]
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "requests",
          "operator": "equals",
          "value": 200,
          "pointer": "/0/http_status"
        },
        {
          "id": "r18",
          "source": "requests",
          "operator": "equals",
          "pointer": "/0/response/choices/0/message/tool_calls/0/function/name",
          "value": "read_fixture"
        },
        {
          "id": "r19",
          "source": "requests",
          "operator": "equals",
          "pointer": "/0/response/choices/0/message/tool_calls/0/function/arguments",
          "value": {
            "label": "sample"
          },
          "transform": "json"
        },
        {
          "id": "r22",
          "source": "requests",
          "operator": "equals",
          "pointer": "/0/response/choices/0/finish_reason",
          "value": "tool_calls"
        },
        {
          "id": "r38",
          "source": "requests",
          "operator": "length_equals",
          "pointer": "/0/response/choices/0/message/tool_calls",
          "value": 1
        },
        {
          "id": "r39",
          "source": "requests",
          "operator": "equals",
          "value": 200,
          "pointer": "/1/http_status"
        },
        {
          "id": "r49",
          "source": "requests",
          "operator": "equals",
          "pointer": "/1/response/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "r51",
          "source": "requests",
          "operator": "equals",
          "value": "GLM_FIXTURE_42",
          "transform": "trim",
          "pointer": "/1/response/choices/0/message/content"
        }
      ],
      "workflow": {
        "mode": "sequence",
        "steps": [
          {
            "id": "step-1",
            "request": {
              "body": {
                "messages": [
                  {
                    "role": "user",
                    "content": "Call read_fixture with label sample to read the test fixture. Do not invent the result."
                  },
                  {
                    "$response": "initial",
                    "pointer": "/choices/0/message"
                  },
                  {
                    "role": "tool",
                    "tool_call_id": {
                      "$response": "initial",
                      "pointer": "/choices/0/message/tool_calls/0/id"
                    },
                    "content": "GLM_FIXTURE_42"
                  },
                  {
                    "role": "user",
                    "content": "Reply only with the fixture value returned by the tool, without explanation."
                  }
                ],
                "max_tokens": 1024,
                "reasoning_effort": "low"
              }
            }
          }
        ]
      }
    }
  }
}
