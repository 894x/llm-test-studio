{
  "schema_version": 2,
  "key": "must.usage_stream",
  "name": "协议 · Usage 流式",
  "dimension": "protocol",
  "protocol": "openai-chat",
  "model_targets": ["kimi-k3", "kimi-k2.7-code", "kimi-k2.7-code-highspeed", "kimi-k2.6"],
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "stream_usage",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说你好"
            }
          ],
          "max_tokens": 50,
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "options": {}
    }
  }
}
