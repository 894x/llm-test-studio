{
  "schema_version": 2,
  "id": "c6b97ab0-a95c-53f9-ab6e-c949d5454b90",
  "key": "must.usage_stream",
  "name": "协议 · Usage 流式",
  "dimension": "protocol",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说你好"
            }
          ],
          "max_tokens": 50,
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "r4",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/stream_frames",
          "value": 2
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/finish_reason"
        },
        {
          "id": "r6",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r9",
          "any": [
            {
              "id": "r7",
              "source": "text",
              "operator": "non_empty",
              "transform": "trim"
            },
            {
              "id": "r8",
              "source": "response",
              "operator": "non_empty",
              "pointer": "/choices/0/message/reasoning_content",
              "transform": "trim"
            }
          ]
        },
        {
          "id": "r10",
          "source": "usage",
          "operator": "type",
          "value": "object"
        }
      ]
    },
    "openai-responses": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": {
            "$input": "prompt"
          },
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "pointer": "/object",
          "value": "response"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "pointer": "/status",
          "value": "completed"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "input_tokens",
          "source": "usage",
          "operator": "gt",
          "pointer": "/input_tokens",
          "value": 0
        },
        {
          "id": "output_tokens",
          "source": "usage",
          "operator": "gt",
          "pointer": "/output_tokens",
          "value": 0
        },
        {
          "id": "usage_arithmetic",
          "source": "usage",
          "operator": "sum_equals",
          "value": {
            "total": "/total_tokens",
            "parts": [
              "/input_tokens",
              "/output_tokens"
            ]
          }
        },
        {
          "id": "visible_text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "input_tokens_type",
          "source": "usage",
          "operator": "type",
          "pointer": "/input_tokens",
          "value": "integer"
        },
        {
          "id": "output_tokens_type",
          "source": "usage",
          "operator": "type",
          "pointer": "/output_tokens",
          "value": "integer"
        },
        {
          "id": "total_tokens_type",
          "source": "usage",
          "operator": "type",
          "pointer": "/total_tokens",
          "value": "integer"
        },
        {
          "id": "stream_terminal",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        }
      ]
    },
    "anthropic-messages": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 2048,
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "message",
          "source": "response",
          "pointer": "/type",
          "operator": "equals",
          "value": "message"
        },
        {
          "id": "stop",
          "source": "response",
          "pointer": "/stop_reason",
          "operator": "non_empty"
        },
        {
          "id": "stream",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "usage",
          "source": "usage",
          "pointer": "/input_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "output_tokens",
          "source": "usage",
          "pointer": "/output_tokens",
          "operator": "gte",
          "value": 1
        },
        {
          "id": "text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
