{
  "schema_version": 2,
  "id": "28d60522-c7f4-5e42-b954-c743322c88e1",
  "key": "json_schema_missing_name",
  "name": "结构化输出 · json_schema 缺少 name 应拒绝",
  "dimension": "structured-output",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "返回 JSON"
            }
          ],
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "schema": {
                "type": "object"
              }
            }
          },
          "max_completion_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
