{
  "schema_version": 3,
  "id": "1b3a7971-4166-4766-bb73-2710cf3a82e0",
  "key": "kvv.partial_tools_high.stream",
  "name": "KVV · Partial 续写 · 工具 + reasoning_effort=high + partial 预填 · stream",
  "description": "目的：检查 Partial 请求能否返回后续工具调用，不比较 token 数目。范围：保留 KVV kvv.partial_tools_high.stream 的原始请求字段组合，SSE 完整结束且无协议错误；至少一个 CodeRunner 调用，参数能解析为 JSON 对象，允许正文为空。返回正文不得再次包含非空预填前缀。不核验固定答案或推理内容。来源：Moonshot KVV 66092cf cases.partial.jsonl；本项目采用续写格式判据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "3214567是素数吗?"
            },
            {
              "role": "assistant",
              "content": "接下来我要写代码了",
              "partial": true
            }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "CodeRunner",
                "description": "代码执行器，支持运行 python 和 javascript 代码",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "enum": [
                        "python",
                        "javascript"
                      ]
                    },
                    "code": {
                      "type": "string",
                      "description": "代码写在这里"
                    }
                  }
                }
              }
            }
          ],
          "tool_choice": "required",
          "reasoning_effort": "high",
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "finish",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "tool_calls"
        },
        {
          "id": "tool_calls",
          "source": "response",
          "operator": "length_gte",
          "pointer": "/choices/0/message/tool_calls",
          "value": 1
        },
        {
          "id": "tool_shape",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "tool_type",
              "source": "item",
              "operator": "equals",
              "pointer": "/type",
              "value": "function"
            },
            {
              "id": "tool_name",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "CodeRunner"
            },
            {
              "id": "tool_arguments",
              "source": "item",
              "operator": "type",
              "pointer": "/function/arguments",
              "value": "object",
              "transform": "json"
            }
          ]
        },
        {
          "id": "no_repeated_prefix",
          "source": "text",
          "operator": "not_contains",
          "value": "接下来我要写代码了"
        }
      ]
    }
  }
}
