{
  "schema_version": 1,
  "key": "glm53.response.contract",
  "name": "GLM 5.3 · 响应结构、终止原因与用量",
  "dimension": "glm53.response",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low"
        }
      },
      "assertions":       [
        {
          "id": "r9",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/message/role",
          "value": "assistant"
        },
        {
          "id": "r10",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/reasoning_content",
          "transform": "trim"
        },
        {
          "id": "r23",
          "source": "usage",
          "operator": "sum_equals",
          "value": {
            "total": "/total_tokens",
            "parts": [
              "/prompt_tokens",
              "/completion_tokens"
            ]
          }
        }
      ]
    }
  }
}
