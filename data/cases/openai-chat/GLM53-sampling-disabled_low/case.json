{
  "schema_version": 2,
  "id": "39a33307-8b27-52ee-9ca0-aece44c5d4ea",
  "key": "glm53.sampling.disabled_low",
  "name": "GLM 5.3 · 禁用采样与low参数",
  "dimension": "glm53.sampling_dependency",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "do_sample": false,
          "temperature": 0,
          "top_p": 0.01
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r11",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "r12",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
