{
  "schema_version": 2,
  "id": "88975a47-466b-5bc3-a362-9ec9aa2ad157",
  "key": "response_format_invalid_type",
  "name": "结构化输出 · response_format 非法枚举应拒绝",
  "dimension": "structured-output",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "返回 JSON"
            }
          ],
          "response_format": {
            "type": "yaml"
          },
          "max_completion_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "返回 JSON"
            }
          ],
          "text": {
            "format": {
              "type": "yaml",
              "schema": {
                "type": "object"
              }
            }
          }
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_type",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/type",
          "value": "invalid_request_error"
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
