{
  "schema_version": 2,
  "id": "c9887ab8-c528-51e4-8ae2-0bcb7949f407",
  "key": "k31.must.multimodal_text_required",
  "name": "K3.1 Pro · 多模态字段 · type=text 时 text 必填",
  "dimension": "multimodal",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text"
                }
              ]
            }
          ],
          "max_tokens": 16
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
