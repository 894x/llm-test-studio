{
  "schema_version": 2,
  "id": "50361472-cfbb-58a4-8f73-9bb3138a8ca0",
  "key": "json_schema_missing_schema",
  "name": "结构化输出 · json_schema 缺少 schema 应拒绝",
  "dimension": "structured-output",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "返回 JSON"
            }
          ],
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "name": "missing_schema"
            }
          },
          "max_completion_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "返回 JSON"
            }
          ],
          "text": {
            "format": {
              "type": "json_schema",
              "name": "missing_schema"
            }
          }
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_type",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/type",
          "value": "invalid_request_error"
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
