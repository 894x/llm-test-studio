{
  "schema_version": 2,
  "id": "b5e3ea2a-68e4-54b9-9e5f-2d69565d029f",
  "key": "max_completion_context_overflow",
  "name": "输出长度 · 1M 输出预算加输入超过上下文应拒绝",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "你好"
            }
          ],
          "max_completion_tokens": 1048576
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
