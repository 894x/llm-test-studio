{
  "schema_version": 2,
  "id": "b5e3ea2a-68e4-54b9-9e5f-2d69565d029f",
  "key": "max_completion_context_overflow",
  "name": "输出长度 · 最大输出预算 1048576",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "你好"
            }
          ],
          "max_completion_tokens": 1048576
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 1048576,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "你好"
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "visible_text",
          "source": "text",
          "operator": "non_empty"
        },
        {
          "id": "usage_arithmetic",
          "any": [
            {
              "id": "usage_arithmetic_missing_0",
              "source": "response",
              "pointer": "/usage/total_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_missing_1",
              "source": "response",
              "pointer": "/usage/input_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_missing_2",
              "source": "response",
              "pointer": "/usage/output_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_value",
              "source": "response",
              "operator": "sum_equals",
              "value": {
                "total": "/total_tokens",
                "parts": [
                  "/input_tokens",
                  "/output_tokens"
                ]
              },
              "pointer": "/usage"
            }
          ]
        }
      ]
    }
  }
}
