{
  "schema_version": 2,
  "key": "T028",
  "name": "流式字符交付速率测试",
  "dimension": "stability",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "stream_throughput",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "输出 20 个由逗号分隔的英文单词，不要解释。"
            }
          ],
          "temperature": 0,
          "max_tokens": 128,
          "stream": true
        }
      },
      "options": {
        "repetitions": 3
      }
    }
  }
}
