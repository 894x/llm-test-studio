{
  "schema_version": 1,
  "key": "T037",
  "name": "Function Calling",
  "dimension": "billing",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "调用 get_weather 查询北京天气"
            }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "查询天气",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "city"
                  ]
                }
              }
            }
          ],
          "tool_choice": "required",
          "temperature": 0,
          "max_tokens": 128
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "r5",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "r3",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/function/name",
              "transform": "trim"
            }
          ]
        }
      ]
    }
  }
}
