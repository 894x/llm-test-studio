{
  "schema_version": 2,
  "id": "afe46c02-bcf7-5db0-8285-cf056361616c",
  "key": "T044",
  "name": "输入长度阶梯采样",
  "dimension": "performance",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {
        "input_repetitions": {
          "type": "integer",
          "unit": "repetitions",
          "default": 128,
          "minimum": 1,
          "maximum": 600000
        },
        "output_tokens": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "maximum": 65536
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$generate": "concat",
                "parts": [
                  {
                    "$generate": "random_text",
                    "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567",
                    "length": 12
                  },
                  " ",
                  {
                    "$generate": "repeat",
                    "text": "token ",
                    "count": {
                      "$input": "input_repetitions"
                    }
                  }
                ]
              }
            }
          ],
          "stream": true,
          "stream_options": {
            "include_usage": true
          },
          "max_tokens": {
            "$input": "output_tokens"
          }
        }
      },
      "assertions": []
    }
  }
}
