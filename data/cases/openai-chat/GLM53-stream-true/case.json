{
  "schema_version": 1,
  "key": "glm53.stream.true",
  "name": "GLM 5.3 · 流式思考与最终回答",
  "dimension": "glm53.stream",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r8",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "r9",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r27",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "r28",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/stream_frames",
          "value": 2
        },
        {
          "id": "r30",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r31",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_data_after_done",
          "value": 0
        },
        {
          "id": "r32",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_content_after_finish",
          "value": 0
        }
      ]
    }
  }
}
