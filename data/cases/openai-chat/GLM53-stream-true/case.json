        {
          "id": "r29",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/finish_reason"
        },
        {
          "id": "r30",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r31",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_data_after_done",
          "value": 0
        },
        {
          "id": "r32",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_content_after_finish",
          "value": 0
        },
        {
          "id": "r33",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_invalid_delta_count",
          "value": 0
        },
        {
          "id": "r34",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_provider_error_count",
          "value": 0
        },
        {
          "id": "r35",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_identity_missing_count",
          "value": 0
        },
        {
          "id": "r36",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_response_ids",
          "value": 1
        },
        {
          "id": "r37",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_model_ids",
          "value": 1
        },
        {
          "id": "r38",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_finish_count",
          "value": 1
        }
      ]
    }
  }
}
