{
  "schema_version": 3,
  "key": "glm53.stream.true",
  "name": "GLM 5.3 · 流式思考与最终回答",
  "dimension": "glm53.stream",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
