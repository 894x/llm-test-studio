          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r5",
          "source": "text",
          "operator": "type",
          "value": "object",
          "transform": "json"
        },
        {
          "id": "r6",
          "source": "text",
          "operator": "contains",
          "value": "name",
          "transform": "json"
        },
        {
          "id": "r7",
          "source": "text",
          "operator": "contains",
          "value": "age",
          "transform": "json"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
