{
  "schema_version": 2,
  "id": "06d41641-33ad-57e3-a2a0-bd02889371c4",
  "key": "prompt_cache_key",
  "name": "缓存键 · prompt_cache_key 字符串应接受",
  "dimension": "cache",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "只回答：你好"
            }
          ],
          "prompt_cache_key": "k3-boundary-session-001",
          "max_completion_tokens": 32
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "只回答：你好"
            }
          ],
          "prompt_cache_key": "k3-boundary-session-001",
          "prompt_cache_options": {
            "mode": "implicit",
            "ttl": "1h"
          }
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        }
      ]
    }
  }
}
