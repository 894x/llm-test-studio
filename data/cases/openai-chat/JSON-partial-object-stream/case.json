{
  "schema_version": 3,
  "id": "f5f0a537-5b2f-4170-b10c-9e025492c8cb",
  "key": "partial.json_object.stream",
  "name": "JSON Partial · 左花括号预填 · stream",
  "description": "目的：验证输入预填前缀与返回后缀能拼成一个完整、合法的 JSON 值。范围：K3 / K3.1 Pro 的 Chat stream，需显式选择；正文须非空白、正常结束，SSE 须完整结束且无协议错误。不比较 token 数目，也不核验固定字段值、类型或额外字段；格式通过不代表提取内容正确。不设置 response_format。来源：项目自编合成数据和 Kimi Partial 文档。",
  "dimension": "workflow",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Return exactly this valid JSON object: {\"answer\":\"PARIS\"}. Use ordinary ASCII double quotation marks for the JSON syntax. Do not add Markdown, explanation, or any text outside the JSON object."
            },
            {
              "role": "assistant",
              "content": "{",
              "partial": true
            }
          ],
          "max_tokens": 1024,
          "stream": true,
          "thinking": {
            "type": "disabled"
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "finish",
          "source": "response",
          "pointer": "/choices/0/finish_reason",
          "operator": "equals",
          "value": "stop"
        },
        {
          "id": "content_type",
          "source": "response",
          "pointer": "/choices/0/message/content",
          "operator": "type",
          "value": "string"
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "json_syntax",
          "source": "text",
          "operator": "json_prefix_valid",
          "value": "{"
        },
        {
          "id": "continuation",
          "source": "text",
          "operator": "regex",
          "value": "\\S"
        }
      ]
    }
  }
}
