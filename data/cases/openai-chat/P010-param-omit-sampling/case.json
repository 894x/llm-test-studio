{
  "schema_version": 1,
  "key": "param_omit_sampling",
  "name": "参数约束 · 不传采样参数（应接受）",
  "dimension": "parameters",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说你好"
            }
          ],
          "max_tokens": 50
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    }
  }
}
