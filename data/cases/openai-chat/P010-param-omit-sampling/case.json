{
  "schema_version": 2,
  "id": "2d2995c3-9766-52e4-be29-72a137d9b55d",
  "key": "param_omit_sampling",
  "name": "参数约束 · 不传采样参数（应接受）",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "说你好"
            }
          ],
          "max_tokens": 50
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": "说你好"
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "pointer": "/object",
          "value": "response"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "pointer": "/status",
          "value": "completed"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        }
      ]
    }
  }
}
