{
  "schema_version": 3,
  "id": "7cd40d22-bffd-585b-a312-4132e6f89f11",
  "key": "kvv.dynamic_missing_parameters.sync",
  "name": "KVV · 动态工具缺少 parameters 应拒绝 · sync",
  "description": "目的：缺少必要字段应拒绝。范围：KVV 行为观察，仅适用于 kimi-k3 和 kimi-k3.1-pro，需显式选择；不证明其他型号或完整 API 覆盖。模式：sync；不发送请求时无供应商执行证据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "system",
              "tools": [
                {
                  "type": "function",
                  "function": {
                    "name": "weather",
                    "description": "查询天气",
                    "strict": true
                  }
                }
              ]
            },
            {
              "role": "user",
              "content": "查询北京天气。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "stream": false
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
