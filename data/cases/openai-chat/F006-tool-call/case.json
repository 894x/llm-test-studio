                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "city"
                  ]
                }
              }
            }
          ],
          "tool_choice": "required",
          "max_tokens": 200
        }
      },
      "assertions": [
        {
          "id": "status",
