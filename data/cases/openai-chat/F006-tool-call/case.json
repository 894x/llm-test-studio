        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "r6",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "r3",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/function/name",
              "transform": "trim"
            },
            {
              "id": "r4",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "get_weather"
            }
          ]
        }
      ]
    },
    "openai-responses": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "查询北京天气。"
        }
      },
      "request": {
        "body": {
          "input": {
            "$input": "prompt"
          },
          "max_output_tokens": 2048,
          "tools": [
            {
              "type": "function",
              "name": "get_weather",
              "description": "查询天气",
              "parameters": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          ],
          "tool_choice": "required"
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "completed",
          "source": "response",
          "pointer": "/status",
          "operator": "equals",
          "value": "completed"
        },
        {
          "id": "tool",
          "source": "metrics",
          "pointer": "/tool_call_count",
          "operator": "gte",
          "value": 1
        }
      ]
    },
    "anthropic-messages": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "查询北京天气。"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
