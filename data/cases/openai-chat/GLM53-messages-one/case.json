{
  "schema_version": 1,
  "key": "glm53.messages.one",
  "name": "GLM 5.3 · 单条用户消息",
  "dimension": "glm53.messages",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r11",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "r12",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
