{
  "schema_version": 3,
  "id": "8748df98-09fc-5d40-adb3-097c0d8ad1af",
  "key": "kvv.tool_choice_required_absent.stream",
  "name": "KVV · required 未声明 tools 应拒绝 · stream",
  "description": "目的：required 需要可用工具。范围：KVV 行为观察，仅适用于 kimi-k3 和 kimi-k3.1-pro，需显式选择；不证明其他型号或完整 API 覆盖。模式：stream；不发送请求时无供应商执行证据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "查询北京天气。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "tool_choice": "required",
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
