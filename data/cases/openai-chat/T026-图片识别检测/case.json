{
  "schema_version": 2,
  "id": "2bad0909-3ba5-581a-9221-d8305ca11631",
  "key": "T026",
  "name": "图片识别检测",
  "dimension": "quality",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "描述图片中的主体、颜色和场景。"
                },
                {
                  "type": "image_url",
                  "image_url": {
                    "url": "https://p9-arcosite.byteimg.com/tos-cn-i-goo7wpa0wc/666b1aa0e24143b285cf2325ad90de77~tplv-goo7wpa0wc-image.image"
                  }
                }
              ]
            }
          ],
          "temperature": 0,
          "max_tokens": 256
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r5",
          "source": "text",
          "operator": "contains",
          "value": "雪",
          "transform": "lower"
        }
      ]
    }
  }
}
