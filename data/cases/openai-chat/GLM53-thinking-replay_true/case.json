  "key": "glm53.thinking.replay_true",
  "name": "GLM 5.3 · 历史思考回传 true",
  "dimension": "glm53.clear_thinking",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Reply with the word GLM_OK."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "thinking": {
            "clear_thinking": true
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "requests",
          "operator": "equals",
          "value": 200,
          "pointer": "/0/http_status"
        },
        {
          "id": "r30",
          "source": "requests",
          "operator": "equals",
          "value": 200,
          "pointer": "/1/http_status"
        },
        {
          "id": "r42",
          "source": "requests",
          "operator": "equals",
          "value": "GLM_REPLAY_OK",
          "transform": "trim",
          "pointer": "/1/response/choices/0/message/content"
        }
      ],
      "workflow": {
        "mode": "sequence",
        "steps": [
          {
            "id": "step-1",
            "request": {
              "body": {
                "messages": [
                  {
                    "role": "user",
                    "content": "Reply with the word GLM_OK."
                  },
                  {
                    "$response": "initial",
                    "pointer": "/choices/0/message"
                  },
                  {
                    "role": "user",
                    "content": "Reply only with GLM_REPLAY_OK."
                  }
                ],
                "max_tokens": 1024,
                "reasoning_effort": "low",
                "thinking": {
                  "clear_thinking": true
                }
              }
            }
          }
        ]
      }
    }
  }
