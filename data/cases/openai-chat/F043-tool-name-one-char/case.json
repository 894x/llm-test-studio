{
  "schema_version": 1,
  "key": "tool_name_one_char",
  "name": "工具定义 · 函数名 1 字符下边界",
  "dimension": "tools",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "必须调用工具 a。"
            }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "a",
                "description": "返回固定值",
                "parameters": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          ],
          "tool_choice": "required",
          "max_completion_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "r6",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "r3",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/function/name",
              "transform": "trim"
            },
            {
              "id": "r4",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "a"
            }
          ]
        }
      ]
    }
  }
}
