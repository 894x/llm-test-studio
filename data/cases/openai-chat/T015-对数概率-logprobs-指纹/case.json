{
  "schema_version": 1,
  "key": "T015",
  "name": "logprobs 接口结构检测",
  "dimension": "identity",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出字母 A"
            }
          ],
          "temperature": 0,
          "max_tokens": 8,
          "logprobs": true,
          "top_logprobs": 1
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/logprobs/content"
        }
      ]
    }
  }
}
