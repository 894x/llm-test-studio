{
  "schema_version": 3,
  "id": "56aafcba-c428-4117-acf1-bb728a00def2",
  "key": "partial.json_extraction.stream",
  "name": "JSON Partial · 结构化提取 · stream",
  "description": "目的：从左花括号续写提取出的商品 JSON。范围：K3 / K3.1 Pro 的 Chat stream，需显式选择；允许正常空白、字段顺序及等价 JSON 转义，拒绝重复前缀、错误值和附加字段。不设置 response_format；1024-token 输出预算，仅语义及协议检查，不比较 token 基准。来源：项目自编合成数据，依据 Kimi Partial 文档和 JSON 排查场景。",
  "dimension": "workflow",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "system",
              "content": "Extract product data into one JSON object with exactly these fields: name (string), size_mm (array of three numbers), price_yuan (number), colors (array of strings in the order listed). Use standard JSON double quotes. Do not add Markdown or explanation."
            },
            {
              "role": "user",
              "content": "Product name: Atlas Mini. Dimensions in millimeters: 120 x 80 x 30. Price in yuan: 299. Available colors, in order: black, silver."
            },
            {
              "role": "assistant",
              "content": "{",
              "partial": true
            }
          ],
          "max_tokens": 1024,
          "stream": true
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "finish",
          "source": "response",
          "pointer": "/choices/0/finish_reason",
          "operator": "equals",
          "value": "stop"
        },
        {
          "id": "content_type",
          "source": "response",
          "pointer": "/choices/0/message/content",
          "operator": "type",
          "value": "string"
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "json_syntax",
          "source": "text",
          "operator": "json_prefix_valid",
          "value": "{"
        },
        {
          "id": "json_value",
          "source": "text",
          "operator": "json_prefix_equals",
          "value": {
            "prefix": "{",
            "expected": {
              "name": "Atlas Mini",
              "size_mm": [
                120,
                80,
                30
              ],
              "price_yuan": 299,
              "colors": [
                "black",
                "silver"
              ]
            }
          }
        }
      ]
    }
  }
}
