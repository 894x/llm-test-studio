                "parameters": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "enum": [
                        "sample"
                      ]
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            }
          ],
          "stream": true,
          "tool_stream": false
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r17",
          "source": "response",
          "operator": "length_equals",
          "pointer": "/choices/0/message/tool_calls",
          "value": 1
        },
        {
          "id": "r15",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/message/tool_calls/0/function/name",
          "value": "read_fixture"
        },
        {
          "id": "r16",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/message/tool_calls/0/function/arguments",
          "value": {
            "label": "sample"
          },
          "transform": "json"
        },
        {
          "id": "r19",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "tool_calls"
        },
        {
          "id": "r35",
