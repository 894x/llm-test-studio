{
  "schema_version": 2,
  "id": "8e41672a-ffa2-5461-998f-96d7cd660dea",
  "key": "dynamic_tool",
  "name": "动态工具 · system tools 消息可调用",
  "dimension": "tools",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "必须使用 calculate 工具计算 23*47。"
            },
            {
              "role": "system",
              "tools": [
                {
                  "type": "function",
                  "function": {
                    "name": "calculate",
                    "description": "计算算术表达式",
                    "parameters": {
                      "type": "object",
                      "properties": {
                        "expression": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "expression"
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "tool_choice": "required",
          "max_completion_tokens": 128
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "r6",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "r3",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/function/name",
              "transform": "trim"
            },
            {
              "id": "r4",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "calculate"
            }
          ]
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "additional_tools",
              "role": "developer",
              "tools": [
                {
                  "type": "function",
                  "name": "calculate",
                  "description": "计算算术表达式",
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "expression": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "expression"
                    ]
                  }
                }
              ]
            },
            {
              "type": "message",
              "role": "user",
              "content": "必须使用 calculate 工具计算 23*47。"
            }
          ],
          "tool_choice": "auto"
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "pointer": "/object",
          "value": "response"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "pointer": "/status",
          "value": "completed"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "tool_count",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/tool_call_count",
          "value": 1
        },
        {
          "id": "function_call",
          "source": "response",
          "pointer": "/output",
          "each_mode": "any",
          "each": [
            {
              "id": "function_type",
              "source": "item",
              "operator": "equals",
              "pointer": "/type",
              "value": "function_call"
            },
            {
              "id": "function_name",
              "source": "item",
              "operator": "equals",
              "pointer": "/name",
              "value": "calculate"
            },
            {
              "id": "call_id",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/call_id"
            },
            {
              "id": "arguments",
              "source": "item",
              "operator": "json_valid",
              "pointer": "/arguments"
            }
          ]
        }
      ]
    }
  }
}
