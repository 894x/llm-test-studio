{
  "schema_version": 1,
  "key": "glm53.tools.stream_true",
  "name": "GLM 5.3 · 流式工具 true",
  "dimension": "glm53.tool_stream",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Call read_fixture with label sample to read the test fixture. Do not invent the result."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "read_fixture",
                "description": "Read the deterministic test fixture. Always call this tool when asked for the fixture.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "enum": [
                        "sample"
                      ]
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            }
          ],
          "stream": true,
          "tool_stream": true
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r17",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "r18",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "r11",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/id",
              "transform": "trim"
            },
            {
              "id": "r12",
              "source": "item",
              "operator": "equals",
              "pointer": "/type",
              "value": "function"
            },
            {
              "id": "r15",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "read_fixture"
            },
            {
              "id": "r16",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/arguments",
              "value": {
                "label": "sample"
              },
              "transform": "json"
            }
          ]
        },
        {
          "id": "r19",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "tool_calls"
        },
        {
          "id": "r20",
          "source": "response",
          "operator": "unique",
          "pointer": "/choices/0/message/tool_calls",
          "value": "/id"
        },
        {
          "id": "r35",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "r36",
          "source": "metrics",
          "operator": "gte",
          "pointer": "/stream_frames",
          "value": 2
        },
        {
          "id": "r38",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "r39",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_data_after_done",
          "value": 0
        },
        {
          "id": "r40",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_content_after_finish",
          "value": 0
        }
      ]
    }
  }
}
