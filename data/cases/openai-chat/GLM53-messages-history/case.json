{
  "schema_version": 2,
  "id": "9672d4cf-2fd0-5575-b933-fdc48df8d917",
  "key": "glm53.messages.history",
  "name": "GLM 5.3 · 多轮历史消息",
  "dimension": "glm53.messages",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Remember the word ORCHID."
            },
            {
              "role": "assistant",
              "content": "I will remember ORCHID."
            },
            {
              "role": "user",
              "content": "Reply only with the word I asked you to remember."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r11",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        },
        {
          "id": "r13",
          "source": "text",
          "operator": "equals",
          "value": "ORCHID",
          "transform": "trim"
        }
      ]
    }
  }
}
