{
  "schema_version": 2,
  "id": "8341f462-d583-56dc-98dc-e4f01af19c17",
  "key": "k31.prompt_cache_breakpoint",
  "name": "K3.1 Pro · 缓存 · 显式缓存断点应拒绝",
  "dimension": "cache",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "prompt_cache_breakpoint"
                },
                {
                  "type": "text",
                  "text": "你好"
                }
              ]
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_message",
          "source": "response",
          "pointer": "/error/message",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
