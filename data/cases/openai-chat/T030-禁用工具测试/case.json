{
  "schema_version": 3,
  "key": "T030",
  "name": "禁用工具测试",
  "dimension": "boundary",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "你好，请直接用文本回复。"
            }
          ],
          "temperature": 0,
          "max_tokens": 64,
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "查询天气",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ],
          "tool_choice": "none"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "r7",
          "any": [
            {
              "id": "r5",
              "source": "response",
              "operator": "not_exists",
              "pointer": "/choices/0/message/tool_calls"
            },
            {
              "id": "r6",
              "source": "response",
              "operator": "length_equals",
              "pointer": "/choices/0/message/tool_calls",
              "value": 0
            }
          ]
        }
      ]
    }
  }
}
