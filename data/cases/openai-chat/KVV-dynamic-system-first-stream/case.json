{
  "schema_version": 3,
  "id": "d12b95c5-5e47-5d67-81e9-d1563573f098",
  "key": "kvv.dynamic_system_first.stream",
  "name": "KVV · 动态工具首条 system 声明可调用 · stream",
  "description": "目的：指定的动态工具被调用。范围：K3/K3.1 Pro 契约，仅适用于 kimi-k3 和 kimi-k3.1-pro，需显式选择；不证明其他型号或完整 API 覆盖。模式：stream；不发送请求时无供应商执行证据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "system",
              "tools": [
                {
                  "type": "function",
                  "function": {
                    "name": "weather",
                    "description": "查询天气",
                    "parameters": {
                      "type": "object",
                      "properties": {
                        "city": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "city"
                      ],
                      "additionalProperties": false
                    },
                    "strict": true
                  }
                }
              ]
            },
            {
              "role": "user",
              "content": "查询北京天气。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "tool_choice": "required",
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "no_data_after_done",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_data_after_done",
          "value": 0
        },
        {
          "id": "no_content_after_finish",
          "source": "metrics",
          "operator": "equals",
          "pointer": "/stream_content_after_finish",
          "value": 0
        },
        {
          "id": "finish",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "tool_calls"
        },
        {
          "id": "calls",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices/0/message/tool_calls"
        },
        {
          "id": "each_call",
          "source": "response",
          "pointer": "/choices/0/message/tool_calls",
          "each": [
            {
              "id": "name",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/name",
              "value": "weather"
            },
            {
              "id": "arguments_shape",
              "source": "item",
              "operator": "equals",
              "pointer": "/function/arguments",
              "value": {
                "city": "string"
              },
              "transform": "json_types"
            }
          ]
        }
      ]
    }
  }
}
