{
  "schema_version": 2,
  "key": "thinking_default_on",
  "name": "思考 · K2.7 Code 默认保留思考",
  "dimension": "reasoning-parameters",
  "protocol": "openai-chat",
  "model_targets": ["kimi-k2.7-code", "kimi-k2.7-code-highspeed"],
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "reasoning_visibility",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "1+1 等于几？为什么？"
            }
          ],
          "max_tokens": 200
        }
      },
      "options": {
        "expected_reasoning_visible": true}
    }
  }
}
