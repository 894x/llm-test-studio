{
  "schema_version": 3,
  "id": "b5c9778d-7be5-5a19-a1a5-d347e00feb72",
  "key": "kvv.format_schema_flat.sync",
  "name": "KVV · 严格响应 Schema 字段类型与额外字段 · sync",
  "description": "目的：JSON 对象恰含 name 字符串与 active 布尔值。范围：K3/K3.1 Pro 契约，仅适用于 kimi-k3 和 kimi-k3.1-pro，需显式选择；不证明其他型号或完整 API 覆盖。模式：sync；不发送请求时无供应商执行证据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "返回姓名和是否在职。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "name": "profile",
              "strict": true,
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "active": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "active"
                ],
                "additionalProperties": false
              }
            }
          },
          "stream": false
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "json_shape",
          "source": "text",
          "operator": "equals",
          "value": {
            "name": "string",
            "active": "boolean"
          },
          "transform": "json_types"
        }
      ]
    }
  }
}
