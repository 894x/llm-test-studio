{
  "schema_version": 1,
  "key": "must.usage_non_stream",
  "name": "协议 · Usage 非流式",
  "dimension": "protocol",
  "protocol": "openai-chat",
  "enabled": true,
  "default": true,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 50
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "usage",
          "operator": "gte",
          "pointer": "/prompt_tokens",
          "value": 1
        },
        {
          "id": "r5",
          "source": "usage",
          "operator": "type",
          "value": "object"
        }
      ]
    }
  }
}
