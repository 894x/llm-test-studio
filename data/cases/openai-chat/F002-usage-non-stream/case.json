{
  "schema_version": 3,
  "id": "0edb2efc-f185-51e7-bf4e-7dcfeef33c96",
  "key": "must.usage_non_stream",
  "name": "协议 · Usage 非流式",
  "description": "目的：检查非流式响应中的用量信息。前提：模型、渠道及所选协议配置可用。通过：Chat 检查 usage 对象及正数输入用量；Messages 检查输入、输出用量和文本；Responses 检查返回的用量字段类型及字段齐全时的加和关系，并允许这些字段缺失。范围：仅按各协议现有断言判断，不校准分词器，也不证明账单金额或精确计费。",
  "dimension": "protocol",
  "enabled": true,
  "default": true,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 50
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "usage",
          "operator": "gte",
          "pointer": "/prompt_tokens",
          "value": 1
        },
        {
          "id": "r5",
          "source": "usage",
          "operator": "type",
          "value": "object"
        }
      ]
    },
    "openai-responses": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": {
            "$input": "prompt"
          }
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "usage_arithmetic",
          "any": [
            {
              "id": "usage_arithmetic_missing_0",
              "source": "response",
              "pointer": "/usage/total_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_missing_1",
              "source": "response",
              "pointer": "/usage/input_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_missing_2",
              "source": "response",
              "pointer": "/usage/output_tokens",
              "operator": "not_exists"
            },
            {
              "id": "usage_arithmetic_value",
              "source": "response",
              "operator": "sum_equals",
              "value": {
                "total": "/total_tokens",
                "parts": [
                  "/input_tokens",
                  "/output_tokens"
                ]
              },
              "pointer": "/usage"
            }
          ]
        },
        {
          "id": "visible_text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        },
        {
          "id": "input_tokens_type",
          "any": [
            {
              "id": "input_tokens_type_omitted",
              "source": "response",
              "pointer": "/usage/input_tokens",
              "operator": "not_exists"
            },
            {
              "id": "input_tokens_type_value",
              "source": "response",
              "operator": "type",
              "pointer": "/usage/input_tokens",
              "value": "integer"
            }
          ]
        },
        {
          "id": "output_tokens_type",
          "any": [
            {
              "id": "output_tokens_type_omitted",
              "source": "response",
              "pointer": "/usage/output_tokens",
              "operator": "not_exists"
            },
            {
              "id": "output_tokens_type_value",
              "source": "response",
              "operator": "type",
              "pointer": "/usage/output_tokens",
              "value": "integer"
            }
          ]
        },
        {
          "id": "total_tokens_type",
          "any": [
            {
              "id": "total_tokens_type_omitted",
              "source": "response",
              "pointer": "/usage/total_tokens",
              "operator": "not_exists"
            },
            {
              "id": "total_tokens_type_value",
              "source": "response",
              "operator": "type",
              "pointer": "/usage/total_tokens",
              "value": "integer"
            }
          ]
        }
      ]
    },
    "anthropic-messages": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "说你好"
        }
      },
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": {
                "$input": "prompt"
              }
            }
          ],
          "max_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "message",
          "source": "response",
          "pointer": "/type",
          "operator": "equals",
          "value": "message"
        },
        {
          "id": "stop",
          "source": "response",
          "pointer": "/stop_reason",
          "operator": "non_empty"
        },
        {
          "id": "usage",
          "source": "usage",
          "pointer": "/input_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "output_tokens",
          "source": "usage",
          "pointer": "/output_tokens",
          "operator": "gte",
          "value": 1
        },
        {
          "id": "text",
          "source": "text",
          "operator": "non_empty",
          "transform": "trim"
        }
      ]
    }
  }
}
