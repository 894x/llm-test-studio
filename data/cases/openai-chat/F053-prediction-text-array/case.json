{
  "schema_version": 2,
  "key": "prediction_text_array",
  "name": "Predicted Output · content 文本对象数组",
  "dimension": "workflow",
  "protocol": "openai-chat",
  "model_targets": ["kimi-k3"],
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {"schema_version": 2, "type": "legacy.apiaudit", "type_version": 1, "spec": {
    "kind": "chat_sync",
    "request": {"method": "POST", "path": "/v1/chat/completions", "headers": {}, "body": {"messages": [{"role": "user", "content": "原样输出 Hello, world!"}], "prediction": {"type": "content", "content": [{"type": "text", "text": "Hello, world!"}]}, "max_completion_tokens": 64}},
    "options": {
        "require_content": false}
  }}
}
