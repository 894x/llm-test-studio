{
  "schema_version": 2,
  "key": "T017",
  "name": "响应时延对标",
  "dimension": "identity",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "chat_sync",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅输出 LATENCY_OK"
            }
          ],
          "temperature": 0,
          "max_tokens": 16
        }
      },
      "options": {
        "expected_exact": "LATENCY_OK",
        "max_elapsed_ms": 5000
      }
    }
  }
}
