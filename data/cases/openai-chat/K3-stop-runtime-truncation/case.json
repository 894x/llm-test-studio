{
  "schema_version": 2,
  "id": "5e1eceec-536d-5ab1-a11c-40a1a99fccea",
  "key": "k3.stop_runtime_truncation",
  "name": "Stop · 运行时输出应在 stop 序列处截断",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "仅逐字输出 AAABBBCCC，不要空格、换行或解释。"
            }
          ],
          "stop": [
            "BBB"
          ],
          "max_completion_tokens": 64
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/choices"
        },
        {
          "id": "r4",
          "source": "text",
          "operator": "contains",
          "value": "AAA"
        },
        {
          "id": "r5",
          "source": "text",
          "operator": "not_contains",
          "value": "BBB"
        },
        {
          "id": "r6",
          "source": "response",
          "operator": "equals",
          "pointer": "/choices/0/finish_reason",
          "value": "stop"
        }
      ]
    }
  }
}
