{
  "schema_version": 3,
  "id": "be26ffe4-12ab-53ef-a573-bfd8be6a082f",
  "key": "kvv.tool_result_missing_id.sync",
  "name": "KVV · tool 消息缺少 tool_call_id 应拒绝 · sync",
  "description": "目的：工具结果缺少关联 ID 应拒绝。范围：KVV 行为观察，仅适用于 kimi-k3 和 kimi-k3.1-pro，需显式选择；不证明其他型号或完整 API 覆盖。模式：sync；不发送请求时无供应商执行证据。",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "tool",
              "content": "天气晴"
            },
            {
              "role": "user",
              "content": "查询北京天气。"
            }
          ],
          "reasoning_effort": "low",
          "max_completion_tokens": 2048,
          "stream": false
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
