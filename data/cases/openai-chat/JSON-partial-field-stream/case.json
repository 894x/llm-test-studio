{
  "schema_version": 3,
  "id": "6bfb9219-8d73-4d8f-9efa-072b4308525a",
  "key": "partial.json_field.stream",
  "name": "JSON Partial · 字段值边界预填 · stream",
  "description": "目的：将预填前缀与返回后缀拼接，验证 JSON 合法性和 answer=PARIS。范围：K3 / K3.1 Pro 的 Chat stream，需显式选择；允许正常空白、字段顺序及等价 JSON 转义，拒绝重复前缀、错误值和附加字段。不设置 response_format；1024-token 输出预算，仅语义及协议检查，不比较 token 基准。来源：项目自编合成数据，依据 Kimi Partial 文档和 JSON 排查场景。",
  "dimension": "workflow",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Return exactly this valid JSON object: {\"answer\":\"PARIS\"}. Use ordinary ASCII double quotation marks for the JSON syntax. Do not add Markdown, explanation, or any text outside the JSON object."
            },
            {
              "role": "assistant",
              "content": "{\"answer\":",
              "partial": true
            }
          ],
          "max_tokens": 1024,
          "stream": true,
          "thinking": {
            "type": "disabled"
          }
        }
      },
      "assertions": [
        {
          "id": "status",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "finish",
          "source": "response",
          "pointer": "/choices/0/finish_reason",
          "operator": "equals",
          "value": "stop"
        },
        {
          "id": "content_type",
          "source": "response",
          "pointer": "/choices/0/message/content",
          "operator": "type",
          "value": "string"
        },
        {
          "id": "done",
          "source": "stream.completed",
          "operator": "equals",
          "value": true
        },
        {
          "id": "json_syntax",
          "source": "text",
          "operator": "json_prefix_valid",
          "value": "{\"answer\":"
        },
        {
          "id": "json_value",
          "source": "text",
          "operator": "json_prefix_equals",
          "value": {
            "prefix": "{\"answer\":",
            "expected": {
              "answer": "PARIS"
            }
          }
        }
      ]
    }
  }
}
