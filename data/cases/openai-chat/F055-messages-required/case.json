{
  "schema_version": 2,
  "id": "8ac55529-2b31-5b3a-bbd6-7c4d54ddd69c",
  "key": "messages_required",
  "name": "消息 · 缺少 messages 应拒绝",
  "dimension": "messages",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "max_completion_tokens": 32
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    },
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "error_type",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/type",
          "value": "invalid_request_error"
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
