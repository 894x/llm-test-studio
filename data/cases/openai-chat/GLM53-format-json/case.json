{
  "schema_version": 1,
  "key": "glm53.format.json",
  "name": "GLM 5.3 · JSON 对象与字段值",
  "dimension": "glm53.response_format",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "Return a JSON object with exactly the boolean field ok set to true."
            }
          ],
          "max_tokens": 1024,
          "reasoning_effort": "low",
          "response_format": {
            "type": "json_object"
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "r13",
          "source": "text",
          "operator": "equals",
          "value": {
            "ok": true
          },
          "transform": "json"
        }
      ]
    }
  }
}
