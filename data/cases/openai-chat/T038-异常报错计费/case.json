{
  "schema_version": 2,
  "id": "7e789bcf-d294-53e6-b40c-5e9738bf46f6",
  "key": "T038",
  "name": "异常响应 usage 可见性",
  "dimension": "billing",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "error usage probe"
            }
          ],
          "max_tokens": -1
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 400
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 500
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
