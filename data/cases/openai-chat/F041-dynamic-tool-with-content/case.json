{
  "schema_version": 1,
  "key": "dynamic_tool_with_content",
  "name": "动态工具 · tools 消息同时携带 content 应拒绝",
  "dimension": "tools",
  "protocol": "openai-chat",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "openai-chat",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "system",
              "content": "非法共存",
              "tools": [
                {
                  "type": "function",
                  "function": {
                    "name": "calculate",
                    "description": "计算",
                    "parameters": {
                      "type": "object"
                    }
                  }
                }
              ]
            },
            {
              "role": "user",
              "content": "计算 1+1"
            }
          ],
          "max_completion_tokens": 32
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
