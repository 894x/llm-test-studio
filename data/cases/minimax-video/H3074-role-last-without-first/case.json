{
  "schema_version": 2,
  "id": "c704d88c-22e6-5be6-ae75-574dd1d1ba6c",
  "key": "h3.role.last_without_first",
  "name": "MiniMax H3 · last_frame 缺少 first_frame",
  "dimension": "dependency",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "manual",
  "definitions": {
    "minimax-video": {
      "inputs": {},
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": "H3边界测试"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "{{H3_IMAGE_NOMINAL}}"
              },
              "role": "last_frame"
            }
          ],
          "resolution": "768P",
          "duration": 4,
          "ratio": "adaptive"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "equals",
          "pointer": "/type",
          "value": "error"
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/type",
          "value": "bad_request_error"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/http_code",
          "value": "400"
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
