{
  "schema_version": 2,
  "id": "57b83e7e-5de8-5361-a557-d656dd65a2d0",
  "key": "h3.image.last_frame_count_above",
  "name": "MiniMax H3 · last_frame 超过 1 张",
  "dimension": "cardinality",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "manual",
  "definitions": {
    "minimax-video": {
      "inputs": {},
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": "H3边界测试"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "{{H3_IMAGE_FIRST}}"
              },
              "role": "first_frame"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "{{H3_IMAGE_LAST_1}}"
              },
              "role": "last_frame"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "{{H3_IMAGE_LAST_2}}"
              },
              "role": "last_frame"
            }
          ],
          "resolution": "768P",
          "duration": 4,
          "ratio": "adaptive"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "r2",
          "source": "response",
          "operator": "equals",
          "pointer": "/type",
          "value": "error"
        },
        {
          "id": "r3",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/type",
          "value": "bad_request_error"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "equals",
          "pointer": "/error/http_code",
          "value": "400"
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message",
          "transform": "trim"
        }
      ]
    }
  }
}
