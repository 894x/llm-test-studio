{
  "schema_version": 2,
  "id": "2e5df312-c3e1-5e45-bd52-5d1be5ac313c",
  "key": "h3.t2v.min_duration",
  "name": "MiniMax H3 · 最小时长 4 秒",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "minimax-video": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "一只小猫在月光下奔跑，电影感镜头"
        }
      },
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": {
                "$input": "prompt"
              }
            }
          ],
          "resolution": "768P",
          "duration": 4,
          "ratio": "16:9"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "succeeded"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/task/content/url"
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/id",
          "expected_from": {
            "source": "task",
            "pointer": "/id"
          }
        },
        {
          "id": "r6",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/model",
          "expected_from": {
            "source": "model"
          }
        },
        {
          "id": "r7",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/task_type",
          "value": "generation"
        },
        {
          "id": "r8",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/modality",
          "value": "video"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
