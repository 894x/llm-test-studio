{
  "schema_version": 1,
  "key": "h3.i2v.first_frame",
  "name": "MiniMax H3 · first_frame 图生视频",
  "dimension": "dependency",
  "protocol": "minimax-video",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 1,
    "type": "minimax-video",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": "H3边界测试"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "{{H3_IMAGE_NOMINAL}}"
              },
              "role": "first_frame"
            }
          ],
          "resolution": "768P",
          "duration": 4,
          "ratio": "adaptive"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "succeeded"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/task/content/url"
        },
        {
          "id": "r5",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/id",
          "expected_from": {
            "source": "task",
            "pointer": "/id"
          }
        },
        {
          "id": "r6",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/model",
          "expected_from": {
            "source": "model"
          }
        },
        {
          "id": "r7",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/task_type",
          "value": "generation"
        },
        {
          "id": "r8",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/modality",
          "value": "video"
        },
        {
          "id": "r9",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/resolution",
          "value": "768P"
        },
        {
          "id": "r10",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/duration",
          "value": 4
        },
        {
          "id": "r11",
          "source": "response",
          "operator": "equals",
          "pointer": "/task/ratio",
          "value": "adaptive"
        },
        {
          "id": "r12",
          "source": "usage",
          "operator": "sum_equals",
          "value": {
            "total": "/total_seconds",
            "parts": [
              "/input_seconds",
              "/output_seconds"
            ]
          }
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
