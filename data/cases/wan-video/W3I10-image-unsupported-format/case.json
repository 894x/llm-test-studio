{
  "schema_version": 2,
  "id": "f4e08e91-b248-5751-8026-bdd161fb9fef",
  "key": "wan30.image.unsupported_format",
  "name": "Wan 3.0 · 图片格式不受支持",
  "dimension": "media-boundary",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_image",
                "url": "fixture://wan3/image/unsupported.gif"
              }
            ]
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r9",
          "any": [
            {
              "id": "r4",
              "all": [
                {
                  "id": "r1",
                  "source": "http.status",
                  "operator": "equals",
                  "value": 400
                },
                {
                  "id": "r2",
                  "source": "response",
                  "operator": "non_empty",
                  "pointer": "/message",
                  "transform": "trim"
                },
                {
                  "id": "r3",
                  "source": "response",
                  "operator": "regex",
                  "pointer": "/code",
                  "value": "(?i)^(invalidparameter($|\\.)|.*\\.invalidparameter$)"
                }
              ]
            },
            {
              "id": "r8",
              "all": [
                {
                  "id": "r5",
                  "source": "task",
                  "operator": "equals",
                  "pointer": "/status",
                  "value": "FAILED"
                },
                {
                  "id": "r6",
                  "source": "response",
                  "operator": "non_empty",
                  "pointer": "/output/message",
                  "transform": "trim"
                },
                {
                  "id": "r7",
                  "source": "response",
                  "operator": "regex",
                  "pointer": "/output/code",
                  "value": "(?i)^(invalidparameter($|\\.)|.*\\.invalidparameter$)"
                }
              ]
            }
          ]
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
