{
  "schema_version": 2,
  "id": "ad804303-fda9-54b3-a064-e9dda6107e3e",
  "key": "wan30.prompt.audio_indexing",
  "name": "Wan 3.0 · Prompt 按顺序引用音频编号",
  "dimension": "semantic",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_audio",
                "url": "fixture://wan3/audio/tone-a.mp3"
              },
              {
                "type": "reference_audio",
                "url": "fixture://wan3/audio/tone-b.mp3"
              }
            ],
            "prompt": "先采用音频1，再过渡到音频2"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
