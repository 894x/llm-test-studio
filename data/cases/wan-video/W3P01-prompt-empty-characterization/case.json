{
  "schema_version": 2,
  "id": "1d7f3a7e-d56f-5874-8626-c71e2e7bd3a9",
  "key": "wan30.prompt.empty_characterization",
  "name": "Wan 3.0 · 空 Prompt 行为刻画",
  "dimension": "characterization",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "prompt": ""
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
