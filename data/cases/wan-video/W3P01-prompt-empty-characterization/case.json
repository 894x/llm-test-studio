{
  "schema_version": 2,
  "key": "wan30.prompt.empty_characterization",
  "name": "Wan 3.0 · 空 Prompt 行为刻画",
  "dimension": "characterization",
  "protocol": "wan-video",
  "model_targets": [
    "wan3.0-video",
    "wan3.0-video-prime"
  ],
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "wan_task_success",
      "request": {
        "method": "POST",
        "path": "/api/v1/services/aigc/video-generation/video-synthesis",
        "headers": {
          "X-DashScope-Async": "enable"
        },
        "body": {
          "input": {
            "prompt": ""
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "options": {
        "reason": "官方未定义空字符串是无内容还是有效 Prompt，不预设通过/拒绝",
        "precondition": "无外部素材；启用前把断言改为观测型"
      }
    }
  }
}
