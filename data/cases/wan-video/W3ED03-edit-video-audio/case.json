{
  "schema_version": 2,
  "id": "29018f29-9a9f-52e8-9561-c94a43fc23ab",
  "key": "wan30.video_edit.video_audio",
  "name": "Wan 3.0 · 视频+音频编辑",
  "dimension": "semantic",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/edit-source.mp4"
              },
              {
                "type": "reference_audio",
                "url": "fixture://wan3/audio/edit-reference.mp3"
              }
            ],
            "prompt": "编辑视频中的主体与风格，同时保留动作连续性"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
