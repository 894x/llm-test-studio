{
  "schema_version": 2,
  "id": "459707fd-366d-58dc-ab60-813c6effbc7d",
  "key": "wan30.environment.same_region",
  "name": "Wan 3.0 · Endpoint、模型与 Key 同地域",
  "dimension": "environment",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "prompt": "一只小猫在月光下奔跑"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
