{
  "schema_version": 3,
  "key": "wan30.prompt.image_indexing",
  "name": "Wan 3.0 · Prompt 按顺序引用图像编号",
  "dimension": "semantic",
  "protocol": "wan-video",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "wan-video",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_image",
                "url": "fixture://wan3/image/red-object.jpg"
              },
              {
                "type": "reference_image",
                "url": "fixture://wan3/image/blue-object.jpg"
              }
            ],
            "prompt": "让图像1中的红色物体靠近图像2中的蓝色物体"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
