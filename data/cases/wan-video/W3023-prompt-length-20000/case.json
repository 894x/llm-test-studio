{
  "schema_version": 1,
  "key": "wan30.prompt.length_20000",
  "name": "Wan 3.0 · Prompt 长度上限 20000",
  "dimension": "boundary",
  "protocol": "wan-video",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 1,
    "type": "wan-video",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "prompt": {
              "$generate": "repeat_text",
              "text": "测",
              "length": 20000
            }
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
