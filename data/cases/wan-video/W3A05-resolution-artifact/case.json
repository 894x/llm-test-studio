{
  "schema_version": 2,
  "id": "8ce13e3b-378f-5903-a89d-e5526fc01133",
  "key": "wan30.artifact.resolution_matches",
  "name": "Wan 3.0 · 产物分辨率匹配 resolution",
  "dimension": "artifact",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "prompt": "一只小猫在月光下奔跑"
          },
          "parameters": {
            "resolution": "1080P",
            "ratio": "adaptive",
            "duration": 2,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
