{
  "schema_version": 2,
  "key": "wan30.video_extension.nonadaptive_rejected",
  "name": "Wan 3.0 · 视频延长使用非 adaptive 比例",
  "dimension": "dependencies",
  "protocol": "wan-video",
  "model_targets": [
    "wan3.0-video",
    "wan3.0-video-prime"
  ],
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "wan_task_rejected",
      "request": {
        "method": "POST",
        "path": "/api/v1/services/aigc/video-generation/video-synthesis",
        "headers": {
          "X-DashScope-Async": "enable"
        },
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/valid-10s.mp4"
              }
            ],
            "prompt": "将视频自然延长"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "16:9",
            "duration": 20,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "options": {
        "reason": "需要合法视频以隔离比例依赖错误",
        "precondition": "需要将 fixture:// 别名解析为同地域可访问且满足边界属性的确定性素材"
      }
    }
  }
}
