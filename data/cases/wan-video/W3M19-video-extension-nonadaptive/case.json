{
  "schema_version": 2,
  "id": "3ea32469-3a9e-5c6a-9ac4-cef1e4e31a20",
  "key": "wan30.video_extension.nonadaptive_rejected",
  "name": "Wan 3.0 · 视频延长使用非 adaptive 比例",
  "dimension": "dependencies",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "manual",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "media": [
              {
                "type": "reference_video",
                "url": "fixture://wan3/video/valid-10s.mp4"
              }
            ],
            "prompt": "将视频自然延长"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "16:9",
            "duration": 20,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r9",
          "any": [
            {
              "id": "r4",
              "all": [
                {
                  "id": "r1",
                  "source": "http.status",
                  "operator": "equals",
                  "value": 400
                },
                {
                  "id": "r2",
                  "source": "response",
                  "operator": "non_empty",
                  "pointer": "/message",
                  "transform": "trim"
                },
                {
                  "id": "r3",
                  "source": "response",
                  "operator": "regex",
                  "pointer": "/code",
                  "value": "(?i)^(invalidparameter($|\\.)|.*\\.invalidparameter$)"
                }
              ]
            },
            {
              "id": "r8",
              "all": [
                {
                  "id": "r5",
                  "source": "task",
                  "operator": "equals",
                  "pointer": "/status",
                  "value": "FAILED"
                },
                {
                  "id": "r6",
                  "source": "response",
                  "operator": "non_empty",
                  "pointer": "/output/message",
                  "transform": "trim"
                },
                {
                  "id": "r7",
                  "source": "response",
                  "operator": "regex",
                  "pointer": "/output/code",
                  "value": "(?i)^(invalidparameter($|\\.)|.*\\.invalidparameter$)"
                }
              ]
            }
          ]
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
