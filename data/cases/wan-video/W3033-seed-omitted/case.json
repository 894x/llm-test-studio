{
  "schema_version": 2,
  "id": "62434257-cc58-5c38-9946-a4a14a609430",
  "key": "wan30.seed.omitted_random",
  "name": "Wan 3.0 · 省略 seed 使用随机值",
  "dimension": "defaults",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "wan-video": {
      "inputs": {},
      "request": {
        "body": {
          "input": {
            "prompt": "一只小猫在月光下奔跑"
          },
          "parameters": {
            "resolution": "480P",
            "ratio": "adaptive",
            "duration": 2,
            "prompt_extend": false,
            "watermark": false,
            "audio": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
