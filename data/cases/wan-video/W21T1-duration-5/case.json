{
  "schema_version": 2,
  "id": "cf334139-f680-5e7f-97f3-9bc3c41a40b5",
  "key": "wan21.turbo.duration_5",
  "name": "Wan 2.1 Turbo · 固定时长 5 秒",
  "dimension": "compatibility",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "wan-video": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "一只小猫在月光下奔跑"
        }
      },
      "request": {
        "body": {
          "input": {
            "prompt": {
              "$input": "prompt"
            }
          },
          "parameters": {
            "size": "832*480",
            "duration": 5,
            "seed": 0,
            "prompt_extend": false,
            "watermark": false
          }
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "SUCCEEDED"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/output/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
