{
  "schema_version": 3,
  "id": "53d51910-3ffe-52b8-9eaa-9704aaf1277a",
  "key": "kimi.protocol.thinking_usage_stream",
  "name": "Kimi K3 / K3.1 · 思考用量完整性 · 流式",
  "description": "目的：发现 K3 / K3.1 在供应商或网关响应中丢失思考用量明细。要求原生 usage、全部总数及 reasoning_tokens / thinking_tokens 为非负整数，思考数不超过输出数；Chat/Responses 检查总数加和。显式零有效，缺失不补零。这是按官方示例选择的严格完整性探针，不把可选属性一概视为强制字段。 流式要求正常结束且无协议问题，检查已保存事件的结构；原始事件最多保存 256 条，不声称所有事件均已检查。 来源及适用范围：doc/kimi-protocol-checks.md，核验日期 2026-11-07。T1；运行时绑定 kimi-k3 或 kimi-k3.1-pro。",
  "dimension": "protocol",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
