{
  "schema_version": 3,
  "id": "71841b16-b022-5a88-9d20-d7912a3f9f17",
  "key": "kimi.protocol.thinking_usage",
  "name": "Kimi K3 / K3.1 · 思考用量完整性",
  "description": "目的：发现 K3 / K3.1 在供应商或网关响应中丢失思考用量明细。要求原生 usage、全部总数及 reasoning_tokens / thinking_tokens 为非负整数，思考数不超过输出数；Chat/Responses 检查总数加和。显式零有效，缺失不补零。这是按官方示例选择的严格完整性探针，不把可选属性一概视为强制字段。 来源及适用范围：doc/kimi-protocol-checks.md，核验日期 2026-11-07。T1；运行时绑定 kimi-k3 或 kimi-k3.1-pro。",
  "dimension": "protocol",
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definitions": {
    "openai-chat": {
      "inputs": {},
      "request": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "计算 17×23，简短回答结果。"
            }
          ],
          "max_tokens": 2048,
          "reasoning_effort": "low"
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "pointer": "",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "issues",
          "source": "issues",
          "pointer": "",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "visible_text",
          "source": "text",
          "pointer": "",
          "operator": "non_empty"
        },
        {
          "id": "usage",
          "source": "response",
          "pointer": "/usage",
          "operator": "type",
          "value": "object"
        },
        {
          "id": "count_prompt_tokens_integer",
          "source": "response",
          "pointer": "/usage/prompt_tokens",
          "operator": "type",
          "value": "integer"
        },
        {
          "id": "count_prompt_tokens_nonnegative",
          "source": "response",
          "pointer": "/usage/prompt_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "count_completion_tokens_integer",
          "source": "response",
          "pointer": "/usage/completion_tokens",
          "operator": "type",
          "value": "integer"
        },
        {
          "id": "count_completion_tokens_nonnegative",
          "source": "response",
          "pointer": "/usage/completion_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "count_total_tokens_integer",
          "source": "response",
          "pointer": "/usage/total_tokens",
          "operator": "type",
          "value": "integer"
        },
        {
          "id": "count_total_tokens_nonnegative",
          "source": "response",
          "pointer": "/usage/total_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "thinking_details",
          "source": "response",
          "pointer": "/usage/completion_tokens_details",
          "operator": "type",
          "value": "object"
        },
        {
          "id": "thinking_integer",
          "source": "response",
          "pointer": "/usage/completion_tokens_details/reasoning_tokens",
          "operator": "type",
          "value": "integer"
        },
        {
          "id": "thinking_nonnegative",
          "source": "response",
          "pointer": "/usage/completion_tokens_details/reasoning_tokens",
          "operator": "gte",
          "value": 0
        },
        {
          "id": "thinking_within_output",
          "source": "response",
          "pointer": "/usage/completion_tokens_details/reasoning_tokens",
          "operator": "lte",
          "expected_from": {
            "source": "response",
            "pointer": "/usage/completion_tokens"
          }
        },
        {
          "id": "usage_sum",
          "source": "response",
          "pointer": "/usage",
          "operator": "sum_equals",
          "value": {
            "total": "/total_tokens",
            "parts": [
              "/prompt_tokens",
              "/completion_tokens"
            ]
          }
        }
      ]
    },
