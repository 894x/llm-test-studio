{
  "schema_version": 3,
  "key": "V004",
  "name": "参考图片生成视频",
  "dimension": "compatibility",
  "protocol": "seedance",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "seedance",
    "type_version": 1,
    "spec": {
      "inputs": {},
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": "Use the subject and visual style from image 1 to create a natural cinematic shot."
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "https://p9-arcosite.byteimg.com/tos-cn-i-goo7wpa0wc/666b1aa0e24143b285cf2325ad90de77~tplv-goo7wpa0wc-image.image"
              },
              "role": "reference_image"
            }
          ],
          "duration": 4,
          "resolution": "480p",
          "ratio": "16:9"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "succeeded"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/content/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
