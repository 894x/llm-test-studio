{
  "schema_version": 2,
  "id": "b8884c60-a426-5ee0-81b0-d0631aa0adf9",
  "key": "V001",
  "name": "纯文本生成视频",
  "dimension": "compatibility",
  "enabled": true,
  "default": true,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "seedance": {
      "inputs": {
        "prompt": {
          "type": "string",
          "default": "A cute cat running through a sunny meadow, cinematic shot"
        }
      },
      "request": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": {
                "$input": "prompt"
              }
            }
          ],
          "duration": 4,
          "resolution": "480p",
          "ratio": "16:9"
        }
      },
      "assertions": [
        {
          "id": "r1",
          "source": "http.status",
          "operator": "gte",
          "value": 200
        },
        {
          "id": "r2",
          "source": "http.status",
          "operator": "lt",
          "value": 300
        },
        {
          "id": "r3",
          "source": "task",
          "operator": "equals",
          "pointer": "/status",
          "value": "succeeded"
        },
        {
          "id": "r4",
          "source": "response",
          "operator": "http_url",
          "pointer": "/content/video_url"
        }
      ],
      "workflow": {
        "mode": "wait"
      }
    }
  }
}
