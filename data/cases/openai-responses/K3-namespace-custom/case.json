{
  "schema_version": 2,
  "id": "742d8c65-0f49-4828-9b2f-038733c8b171",
  "key": "k3.responses.namespace_custom",
  "name": "K3 Responses · namespace custom 调用",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "请使用 apply_patch 创建 hello.txt，内容为 hello。只调用工具。工具位于 math_tools。",
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048,
          "tools": [
            {
              "type": "namespace",
              "name": "math_tools",
              "description": "数值工具",
              "tools": [
                {
                  "type": "custom",
                  "name": "apply_patch",
                  "description": "生成补丁创建 hello.txt，内容为 hello。",
                  "format": {
                    "type": "grammar",
                    "syntax": "lark",
                    "definition": "start: \"*** Begin Patch\\n*** Add File: hello.txt\\n+hello\\n*** End Patch\""
                  }
                }
              ]
            }
          ],
          "tool_choice": "auto"
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "custom_call",
          "source": "response",
          "pointer": "/output",
          "each_mode": "any",
          "each": [
            {
              "id": "custom_type",
              "source": "item",
              "operator": "equals",
              "value": "custom_tool_call",
              "pointer": "/type"
            },
            {
              "id": "custom_name",
              "source": "item",
              "operator": "equals",
              "value": "apply_patch",
              "pointer": "/name"
            },
            {
              "id": "custom_id",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/call_id"
            },
            {
              "id": "custom_input",
              "source": "item",
              "operator": "contains",
              "value": "*** Begin Patch",
              "pointer": "/input"
            },
            {
              "id": "custom_file",
              "source": "item",
              "operator": "contains",
              "value": "hello.txt",
              "pointer": "/input"
            },
            {
              "id": "custom_namespace",
              "source": "item",
              "operator": "equals",
              "value": "math_tools",
              "pointer": "/namespace"
            }
          ]
        }
      ]
    }
  }
}
