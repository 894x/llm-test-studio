{
  "schema_version": 2,
  "id": "97620e94-6234-4160-b0c8-dc390505845b",
  "key": "k3.responses.search_image_max_5",
  "name": "K3 Responses · 图片搜索 max_results=5",
  "dimension": "parameters",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "请联网搜索 Kimi 官方 logo 图片，返回图片。",
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048,
          "tools": [
            {
              "type": "web_search",
              "filters": {
                "allowed_domains": [
                  "platform.kimi.com"
                ]
              },
              "search_content_types": [
                "text",
                "image"
              ],
              "image_settings": {
                "max_results": 5,
                "caption": false
              }
            }
          ],
          "tool_choice": "auto",
          "include": [
            "web_search_call.action.sources",
            "web_search_call.results"
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "value": "response",
          "pointer": "/object"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "value": "completed",
          "pointer": "/status"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "visible_answer",
          "source": "text",
          "operator": "non_empty"
        },
        {
          "id": "search_result",
          "source": "response",
          "pointer": "/output",
          "each_mode": "any",
          "each": [
            {
              "id": "search_type",
              "source": "item",
              "operator": "equals",
              "value": "web_search_call",
              "pointer": "/type"
            },
            {
              "id": "search_status",
              "source": "item",
              "operator": "equals",
              "value": "completed",
              "pointer": "/status"
            },
            {
              "id": "images",
              "source": "item",
              "operator": "non_empty",
              "pointer": "/results"
            },
            {
              "id": "image_count",
              "source": "item",
              "operator": "length_lte",
              "value": 5,
              "pointer": "/results"
            },
            {
              "id": "image_urls",
              "source": "item",
              "pointer": "/results",
              "each": [
                {
                  "id": "image_type",
                  "source": "item",
                  "operator": "equals",
                  "value": "image_result",
                  "pointer": "/type"
                },
                {
                  "id": "image_url",
                  "source": "item",
                  "operator": "http_url",
                  "pointer": "/image_url"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
