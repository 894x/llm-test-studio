{
  "schema_version": 2,
  "id": "bb929103-2dc9-4549-a874-3ee3fa621d08",
  "key": "k3.responses.include_without_search",
  "name": "K3 Responses · 无搜索工具时 include 无效果",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "只回答 READY，不要解释。",
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048,
          "include": [
            "web_search_call.results",
            "web_search_call.action.sources"
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "value": "response",
          "pointer": "/object"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "value": "completed",
          "pointer": "/status"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "answer",
          "source": "text",
          "operator": "equals",
          "value": "READY",
          "transform": "trim"
        },
        {
          "id": "no_search",
          "source": "response",
          "pointer": "/output",
          "each": [
            {
              "id": "no_search_type",
              "source": "item",
              "operator": "not_equals",
              "value": "web_search_call",
              "pointer": "/type"
            }
          ]
        }
      ]
    }
  }
}
