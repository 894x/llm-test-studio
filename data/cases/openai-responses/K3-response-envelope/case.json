              "value": false,
              "pointer": "/store"
            }
          ]
        },
        {
          "id": "background",
          "any": [
            {
              "id": "background_omitted",
              "source": "response",
              "pointer": "/background",
              "operator": "not_exists"
            },
            {
              "id": "background_null",
              "source": "response",
              "pointer": "/background",
              "operator": "equals",
              "value": null
            },
            {
              "id": "background_value",
              "source": "response",
              "operator": "equals",
              "value": false,
              "pointer": "/background"
            }
          ]
        },
        {
