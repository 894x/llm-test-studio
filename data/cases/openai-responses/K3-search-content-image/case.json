{
  "schema_version": 2,
  "id": "e08d9fc9-2c83-4397-bf1a-bcf8c2a09634",
  "key": "k3.responses.search_content_image",
  "name": "K3 Responses · 搜索类型 image",
  "dimension": "parameters",
  "enabled": false,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "请联网搜索 Kimi 官方 logo 图片，返回图片。",
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048,
          "tools": [
            {
              "type": "web_search",
              "filters": {
                "allowed_domains": [
                  "platform.kimi.com"
                ]
              },
              "search_content_types": [
                "image"
              ],
              "image_settings": {
                "max_results": 3,
                "caption": false
              }
            }
          ],
          "tool_choice": "auto",
          "include": [
            "web_search_call.action.sources",
            "web_search_call.results"
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "visible_answer",
          "source": "text",
          "operator": "non_empty"
        },
        {
          "id": "search_result",
          "any": [
            {
              "id": "search_result_omitted",
              "source": "response",
              "pointer": "/output",
              "operator": "not_exists"
            },
            {
              "id": "search_result_value",
              "source": "response",
              "pointer": "/output",
              "each": [
                {
                  "id": "search_item",
                  "any": [
                    {
                      "id": "type_omitted",
                      "source": "item",
                      "pointer": "/type",
                      "operator": "not_exists"
                    },
                    {
                      "id": "other_item",
                      "source": "item",
                      "pointer": "/type",
                      "operator": "not_equals",
                      "value": "web_search_call"
                    },
                    {
                      "id": "returned_search",
                      "all": [
                        {
                          "id": "search_type",
                          "source": "item",
                          "pointer": "/type",
                          "operator": "equals",
                          "value": "web_search_call"
                        },
                        {
                          "id": "image_count",
                          "any": [
                            {
                              "id": "image_count_omitted",
                              "source": "item",
                              "pointer": "/results",
                              "operator": "not_exists"
                            },
                            {
                              "id": "image_count_value",
                              "source": "item",
                              "operator": "length_lte",
                              "value": 3,
                              "pointer": "/results"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
