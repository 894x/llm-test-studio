{
  "schema_version": 2,
  "id": "3f787b88-b85b-465e-b6cc-41d7d7e2f231",
  "key": "k3.responses.search_history",
  "name": "K3 Responses · web_search_call 历史回放",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": [
            {
              "type": "web_search_call",
              "status": "completed",
              "action": {
                "type": "search",
                "query": "client-authored history"
              }
            },
            {
              "type": "message",
              "role": "assistant",
              "content": "代码是 READY。"
            },
            {
              "type": "message",
              "role": "user",
              "content": "只回答上文代码。"
            }
          ],
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "value": "response",
          "pointer": "/object"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "value": "completed",
          "pointer": "/status"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "answer",
          "source": "text",
          "operator": "equals",
          "value": "READY",
          "transform": "trim"
        }
      ]
    }
  }
}
