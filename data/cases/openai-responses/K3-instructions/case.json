{
  "schema_version": 2,
  "id": "dd384f19-1bc5-487b-968b-c4b95cf88670",
  "key": "k3.responses.instructions",
  "name": "K3 Responses · 顶层 instructions 生效",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "返回约定的代码。",
          "reasoning": {
            "effort": "low"
          },
          "max_output_tokens": 2048,
          "instructions": "只回答 READY，不要解释。"
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 200
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "object",
          "source": "response",
          "operator": "equals",
          "value": "response",
          "pointer": "/object"
        },
        {
          "id": "terminal",
          "source": "response",
          "operator": "equals",
          "value": "completed",
          "pointer": "/status"
        },
        {
          "id": "output",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/output"
        },
        {
          "id": "answer",
          "source": "text",
          "operator": "equals",
          "value": "READY",
          "transform": "trim"
        }
      ]
    }
  }
}
