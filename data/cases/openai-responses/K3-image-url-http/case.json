{
  "schema_version": 2,
  "id": "3a7dba4d-719e-445b-a60f-19f414ae3e8e",
  "key": "k3.responses.image_url_http",
  "name": "K3 Responses · 图片 URL http 应拒绝",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "max_output_tokens": 2048,
          "input": [
            {
              "type": "message",
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "只回答图片中央的数字，不要解释。"
                },
                {
                  "type": "input_image",
                  "image_url": "https://example.com/digit.png"
                }
              ]
            }
          ]
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "type",
          "pointer": "/error/message",
          "value": "string"
        }
      ]
    }
  }
}
