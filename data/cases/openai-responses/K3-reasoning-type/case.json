{
  "schema_version": 2,
  "id": "db884471-4df6-4127-8faa-40b350114065",
  "key": "k3.responses.reasoning_type",
  "name": "K3 Responses · reasoning 错误类型",
  "dimension": "parameters",
  "enabled": true,
  "default": false,
  "severity": "normal",
  "execution_mode": "automatic",
  "definitions": {
    "openai-responses": {
      "inputs": {},
      "request": {
        "body": {
          "input": "只回答 READY，不要解释。",
          "reasoning": "low",
          "max_output_tokens": 2048
        }
      },
      "assertions": [
        {
          "id": "http",
          "source": "http.status",
          "operator": "equals",
          "value": 400
        },
        {
          "id": "protocol",
          "source": "issues",
          "operator": "length_equals",
          "value": 0
        },
        {
          "id": "error_type",
          "source": "response",
          "operator": "equals",
          "value": "invalid_request_error",
          "pointer": "/error/type"
        },
        {
          "id": "error_message",
          "source": "response",
          "operator": "non_empty",
          "pointer": "/error/message"
        }
      ]
    }
  }
}
