{
  "schema_version": 2,
  "key": "must.image_url_string",
  "name": "多模态图像 · image_url 字符串形式",
  "dimension": "multimodal",
  "protocol": "kimi-k3",
  "model_targets": ["kimi-k3"],
  "enabled": true,
  "default": false,
  "severity": "critical",
  "execution_mode": "automatic",
  "definition": {
    "schema_version": 2,
    "type": "legacy.apiaudit",
    "type_version": 1,
    "spec": {
      "kind": "kimi_success",
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": {},
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "只回答图片中央的数字，不要解释。"
                },
                {
                  "type": "image_url",
                  "image_url": "data:image/png;base64,"
                }
              ]
            }
          ],
          "max_tokens": 2048
        }
      },
      "options": {
        "expected_digit_sequence": "7",
        "require_content": true
      }
    }
  }
}
